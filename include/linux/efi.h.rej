+	u32 romimage;
 } efi_pci_io_protocol_32;
 
 typedef struct {
@@ -399,8 +400,8 @@ typedef struct {
 	u64 attributes;
 	u64 get_bar_attributes;
 	u64 set_bar_attributes;
-	uint64_t romsize;
