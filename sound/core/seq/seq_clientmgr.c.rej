 		event->time.tick = snd_seq_timer_get_cur_tick(q->timer);
@@ -663,7 +664,7 @@ static int deliver_to_subscribers(struct snd_seq_client *client,
 	if (atomic)
 		read_lock(&grp->list_lock);
 	else
-		down_read(&grp->list_mutex);
