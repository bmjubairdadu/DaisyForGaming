 		range.flags |= NF_NAT_RANGE_PROTO_SPECIFIED;
 	}
 
@@ -135,7 +135,7 @@ static int nft_nat_init(const struct nft_ctx *ctx, const struct nft_expr *expr,
 		priv->type = NF_NAT_MANIP_DST;
 		break;
 	default:
