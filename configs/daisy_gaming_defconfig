# DaisyForGaming - gaming + Treble fragment for verified 4.9.337 daisy
# Base: TogoFire/kernel_xiaomi_panda @ ff7b84e (VERSION=4 PATCHLEVEL=9 SUBLEVEL=337)
# Merged over stock daisy_defconfig by build.sh.
# Minimal-safe only: no choice/default overrides, no arch-incompatible symbols.

# === CPU governors (v2.3: performance.c proven in tree + gaming backport) ===
# Proven files: cpufreq_performance.c + cpufreq_powersave.c exist in tree.
# v2.3 wires them via Kconfig/Makefile (powersave-template API, boot-safe).
# INTERACTIVE does NOT exist in tree - excluded to avoid bootloop.
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
# NOTE: GOV_PERFORMANCE/GAMING intentionally absent - no Kconfig symbol in
# drivers/cpufreq/Kconfig, no Makefile object; olddefconfig drops them.
# NOTE: CONFIG_CPU_BOOST intentionally OFF - cpu-boost.c in this tree includes
# <uapi/linux/sched/types.h> which does not exist -> compile break / boot risk.
# Stock INPUT_BOOST (already y with safe 652800/1401600 freqs) covers touch boost.
CONFIG_CPU_INPUT_BOOST=y
CONFIG_CGROUP_SCHEDTUNE=y

# === App-launch responsiveness (v1.1: fixes slow app opening on schedutil) ===
# Root cause: stock schedutil hard-codes up_rate_limit_us=20000 (20ms delay
# before every freq step-up) and this 4.9 tree exposes NO sysfs tunable for
# it (sugov_attributes[] is empty). patches/schedutil-fastramp.patch lowers
# it to 500us so CPU jumps to needed freq instantly on touch/app start.
# ondemand (up_threshold 98, io_is_busy-aware) stays as runtime fallback:
# echo ondemand > /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
# INPUT_BOOST durations tuned for app tap: 100ms touch / 500ms wake are the
# Kconfig defaults and kept (longer = wasted power, shorter = missed ramp).
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# === TCP congestion: BBR available for gaming, keep stock westwood default ===
# Proven: TCP_CONG_BBR/CUBIC/WESTWOOD exist. Do NOT touch DEFAULT_* choice
# (choice override = silentoldconfig hang risk). Default stays westwood,
# user can echo bbr > /proc/sys/net/ipv4/tcp_congestion_control.
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y

# === IO scheduler: BFQ exists in tree, CFQ stays default (boot-safe) ===
# Proven: IOSCHED_BFQ/CFQ/NOOP exist, default CFQ. Do NOT touch DEFAULT_*
# choice. BFQ available at runtime via /sys/block/*/queue/scheduler.
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_IOSCHED_CFQ=y
CONFIG_IOSCHED_NOOP=y

# === GPU: msm-adreno-tz already default, adreno_idler present ===
# Proven: DEVFREQ_GOV_QCOM_ADRENO_TZ=y + ADRENO_IDLER=y + default
# "msm-adreno-tz" already in stock defconfig. No DTB OC (GPU 650MHz stock
# table kept - DTB freq edit = hard-brick/bootloop risk on daisy panel).
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_ADRENO_IDLER=y

# === Display: KCAL driver exists, enable control (proven symbol) ===
# Proven: FB_MSM_MDSS=y + mdss_mdp_kcal_ctrl.c + symbol FB_MSM_MDSS_KCAL_CTRL.
CONFIG_FB_MSM_MDSS_KCAL_CTRL=y

# === ZRAM: stock defconfig already y, keep (no LZ4 symbol exists) ===
# Proven: ZRAM=y + CRYPTO_LZ4=y + default comp "lz4" already in tree.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# === Wakelock blocker (v2.3 minimal sysfs filter, default OFF = stock boot) ===
# Patched in kernel/power/wakelock.c: module param "wakelock_block".
# Empty by default -> pm_wake_lock path unchanged -> boot-safe.
# User enables at runtime: echo "wlan_rx" > /sys/module/wakelock/parameters/wakelock_block
CONFIG_PM_WAKELOCKS=y

# === DT2W: Focaltech gesture sysfs already present (FTS_GESTURE_EN=1) ===
# Proven: fts_gesture_mode sysfs node in focaltech_gesture.c.
# Enable via: echo 1 > /sys/devices/soc/.../i2c.../fts_gesture_mode (Kernel Adiutor/EXKM).
# No DTS edit (panel DTS touch node edit = bootloop risk).
# Fsync sysfs (fsync_enabled @ /sys/module/sync/parameters) + powersuspend hooks already y.
CONFIG_DEBUG_FS=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ION=y
CONFIG_OVERLAY_FS=y
CONFIG_DM_VERITY=y
CONFIG_F2FS_FS=y
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y

# === FolkPatch/KernelPatch compatibility (official requirement) ===
# Official requirement is ONLY: KALLSYMS=y + KALLSYMS_ALL=y
# (arm64, kernel 3.18-6.15). Rest below stabilizes APM/OverlayFS on 4.9.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# APM Magic Mount needs xattr/acl on tmpfs upper layer (already in base,
# made explicit; symbols verified in fs/Kconfig).
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
# File-handle syscalls (init/Kconfig, default y in tree).
# VINTF matrix wants n and stock daisy base has it off, so keep it OFF
# to stay byte-consistent with stock. KP/APM do NOT require it
# (official KP requirement is only KALLSYMS).
# CONFIG_FHANDLE is not set
# Let FolkPatch app read running config via /proc/config.gz (already in base).
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK=y
# NOTE: TRIM_UNUSED_KSYMS stays off (depends on MODULES && !UNUSED_SYMBOLS,
# but UNUSED_SYMBOLS would hide symbols KP needs at runtime).
# KP stability needs gc-sections OFF: stock .text layout keeps hook anchors
# deterministic. The 2 anchor symbols stay protected by KEEP() LDS patch.

# === Future-proof root ecosystem (verified symbols only, boot-safe) ===
# Goal: any future APatch/FolkPatch/KSU-next style boot-image patcher works
# without rebuilding kernel. All symbols below verified in this 4.9 tree.
# Namespaces/cgroups used by modules/containers (lightweight, boot-safe).
CONFIG_PID_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# USER_NS default n in tree (init/Kconfig:1066). Safe to enable, needed by
# future container/sandbox features. Does not change stock boot path.
CONFIG_USER_NS=y
# --- Keep patcher-friendly protections OFF (do NOT turn these ON) ---
# DEBUG_RODATA / STRICT_DEVMEM / CFI / LTO would make kernel text
# read-only or break inline-hook. Base already has them off - pin it here
# so future merges never flip them on.
# KALLSYMS_BASE_RELATIVE off = absolute table. This fixes the KP log
# "kallsyms_markers elem_size 8 rejected" fallback on 4.9 and stops the
# app-open freeze/poweroff caused by hooks landing on wrong addresses.
# (patches/kallsyms-all-legacy.patch sets default n in init/Kconfig.)
# CONFIG_KALLSYMS_BASE_RELATIVE is not set
# KP hook stability: era-correct GNU BFD linker + no gc-sections.
# Fixes log "can't find arm64 relocation table" (LLD+RELR) and hooks
# landing on wrong addresses (gc-sections reordering .text on 4.9/GCC).
CONFIG_LD_BFD=y
# CONFIG_LD_LLD is not set
# CONFIG_LD_DEAD_CODE_DATA_ELIMINATION is not set
# CONFIG_DEBUG_RODATA is not set
# CONFIG_DEBUG_SET_MODULE_RONX is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_SECURITY_DMESG_RESTRICT is not set
# --- Deliberately NOT enabled (would hurt boot/size, not needed by KP) ---
# MEMCG/MEMCG_SWAP: +RAM overhead on 3GB daisy, not needed for root.
# FTRACE/KPROBES: +size/overhead, KP uses own inline-hook, not kprobes.

# === VINTF build-consistency (fixes "internal problem" dialog, logcat: ===
# === "Build fingerprint is not consistent") ===
# Device runs Treble (ro.treble.enabled=true): framework runs
# VintfObject.verifyWithoutAvb against matrix level 3 (4.9.84 block).
# Stock daisy ROM ships these, our fragment had them off/missing.
# All symbols verified in this 4.9 tree; boot-safe, no behavior change
# (idle code paths only, stock defaults kept).
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_PROFILING=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
# NOTE: CONFIG_FHANDLE stays off to match VINTF matrix (want n) and stock
# base. KP official requirement is only KALLSYMS; APM works without it.
# NOTE: QTAGUID/OWNER are mutually exclusive in tree
# (QTAGUID depends on OWNER=n) - matrix has both blocks behind conditions,
# our OWNER=y satisfies the active one; QTAGUID stays off by design.
# NOTE: NFS_FS/NFSD stay off (single missing-n tolerated) - enabling NFS
# server+client bloats boot image for zero benefit on daisy.

# === VINTF MODULES block (matrix 4.9 main block wants MODULES=y) ===
# Proven 2026-09-14 on live daisy (crDroid 11 + DaisyForGaming 4.9.337):
# /system/etc/vintf/compatibility_matrix.3.xml 4.9.84 main block (185 cfgs,
# no conditions) mismatches ONLY these 3 when MODULES=n:
#   CONFIG_MODULES=y, CONFIG_MODULE_UNLOAD=y, CONFIG_MODVERSIONS=y
# (NFS_FS/NFSD want n = absent->n already matches; QTAGUID/OWNER/ARM blocks
# are conditional and already satisfied by OWNER=y). That mismatch is what
# VintfObject.verifyWithoutAvb fails on -> "internal problem" dialog.
# Boot-safe: no .ko ships in boot img; vendor modules (if any) load from
# vendor. MODULE_SIG stays n (not in matrix = unsigned path stock uses),
# UNUSED_SYMBOLS stays n (KP needs symbols visible).
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
# CONFIG_MODULE_SIG is not set
# CONFIG_UNUSED_SYMBOLS is not set

# === Play Integrity hardening (kernel side, no userspace spoof) ===
# Honest posture: stock-like provenance so BASIC + DEVICE verdicts pass on
# unlocked-bootloader custom kernel. STRONG needs locked BL + keybox, which
# no custom kernel can provide - not claimed here.
# - LOCALVERSION stays -DaisyForGaming (no "dirty"/test tags that scream custom)
# - PRINTK stays y: KP/kmsg/dmesg/FolkPatch debugging needs it; scanners
#   read props, not dmesg chatter. Turning it off blinds early-boot debug.
# - No BUILD_SALT tampering: keep stock build fingerprint derivation.
# - BUG=y: HARDENED_USERCOPY selects it; also gives clean WARN() instead of
#   silent corruption that SafetyNet/PI native checks flag as tampering.
CONFIG_PRINTK=y
CONFIG_BUG=y
# Play Integrity userspace (NOT in kernel - do these on device):
# 1. Magisk/FolkPatch root + PlayIntegrityFix or TrickyStore module
#    (valid keybox/FP spoof lives in userspace, never in kernel source).
# 2. Do NOT add ro.build.fingerprint overrides to anykernel.sh - props
#    set from boot img are trivially detectable vs module-based resetprop.

# === SAFETY: force all known root hooks OFF (100% SAFE, No Pre-Root) ===
# CONFIG_KSU is not set
# CONFIG_APATCH is not set
# CONFIG_KPM is not set
# CONFIG_FOLKPATCH is not set
