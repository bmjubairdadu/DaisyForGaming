# DaisyForGaming v1.2 fragment - verified 4.9.337 daisy (TogoFire @ ff7b84e).
# Merged over stock daisy_defconfig by build.sh. No choice/default overrides.

# --- CPU: schedutil/ondemand/conservative/powersave/userspace + input-boost ---
# No performance/gaming/interactive governor in tree. App-launch fix via
# patches/schedutil-fastramp.patch (up 2ms + down hold 10ms; v1.2 stable).
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_INPUT_BOOST=y
CONFIG_CGROUP_SCHEDTUNE=y

# --- TCP: BBR/CUBIC/WESTWOOD (DEFAULT_* untouched; CUBIC at boot via sysctl) ---
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y

# --- IO: BFQ/CFQ/NOOP (default CFQ; BFQ via sysfs at runtime) ---
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_IOSCHED_CFQ=y
CONFIG_IOSCHED_NOOP=y

# --- GPU: msm-adreno-tz + idler, no DTB OC (brick risk; tuned by patch) ---
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_ADRENO_IDLER=y

# --- Display: KCAL / ZRAM lz4 / stock wakelocks / Treble base ---
CONFIG_FB_MSM_MDSS_KCAL_CTRL=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_PM_WAKELOCKS=y
CONFIG_DEBUG_FS=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ION=y
CONFIG_OVERLAY_FS=y
CONFIG_DM_VERITY=y
CONFIG_F2FS_FS=y
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y

# --- APatch/KernelPatch requirement: KALLSYMS + KALLSYMS_ALL (absolute table) ---
# arm64 forces DEBUG_RODATA=y (does not block APatch); BFD ld, no gc-sections.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
# CONFIG_FHANDLE is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK=y

# --- Namespaces for patchers/containers + Magisk mount isolation ---
# IPC_NS needs POSIX_MQUEUE (SYSVIPC off in base); Magisk uses mount
# namespaces for systemless modules, IPC_NS completes the set.
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_USER_NS=y
CONFIG_LD_BFD=y
# CONFIG_LD_LLD is not set
# CONFIG_LD_DEAD_CODE_DATA_ELIMINATION is not set
# CONFIG_DEBUG_RODATA is not set
# CONFIG_DEBUG_SET_MODULE_RONX is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_SECURITY_DMESG_RESTRICT is not set

# --- VINTF 4.9.84 matrix match (fixes "internal problem" dialog) ---
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_PROFILING=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
# CONFIG_MODULE_SIG is not set
CONFIG_BUG=y
# CONFIG_KSU is not set
# CONFIG_APATCH is not set
# CONFIG_KPM is not set
# CONFIG_FOLKPATCH is not set

# --- Extras (probed to stick; DEVMEM/FTRACE/NFS dead in tree) ---
# CONFIG_DEVMEM is not set
# CONFIG_DEVKMEM is not set
CONFIG_KSM=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_VM_EVENT_COUNTERS=y
CONFIG_COMPACT_UNEVICTABLE_DEFAULT=1
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_CHECK_FS=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_SCHED_DEBUG=y
CONFIG_DETECT_HUNG_TASK=y
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KEXEC is not set
# CONFIG_LKDTM is not set

# --- Video-smooth: readahead 1MB, ZRAM in-RAM only ---
CONFIG_VM_MAX_READAHEAD=256
# CONFIG_ZRAM_WRITEBACK is not set

# --- Universal patcher hooks (APatch/FolkPatch/KernelPatch + Magisk/ZygiskNext) ---
# PROBED 2026-09-15: KPROBES=y sticks (MODULES + HAVE_KPROBES on). PROC_KCORE,
# UNUSED_SYMBOLS, CPU_FREQ_STAT/TIMES, DYNAMIC_FSYNC, DEVFREQ_BOOST all stick.
# KPROBE_EVENT/UPROBE_EVENT/FTRACE can NOT stick in this tree: they live
# inside "if FTRACE" (kernel/trace/Kconfig:173-771), FTRACE needs
# TRACING_SUPPORT, which needs STACKTRACE_SUPPORT, but arch/arm64/Kconfig
# forces "config STACKTRACE_SUPPORT def_bool n". No patcher needs them:
# APatch/FolkPatch use KALLSYMS absolute table (above), Magisk/ZygiskNext
# use ptrace/namespaces/OverlayFS (below) - all present.
CONFIG_KPROBES=y
CONFIG_PROC_KCORE=y
CONFIG_UNUSED_SYMBOLS=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_TIMES=y

# --- Extra features (probed; DEADLINE dropped) ---
CONFIG_FANOTIFY=y
CONFIG_SCHEDSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_F2FS_STAT_FS=y
CONFIG_CPU_FREQ_STAT_DETAILS=y
CONFIG_TCP_CONG_HYBLA=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_VENO=y
CONFIG_TCP_CONG_ILLINOIS=y
CONFIG_TCP_CONG_DCTCP=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_SQUASHFS=y
CONFIG_SW_SYNC=y
CONFIG_KSM_LEGACY=y
# Controller sysfs already in tree: DYNAMIC_FSYNC (dyn_fsync_active),
# POWERSUSPEND + MSM_PERFORMANCE + STATE_NOTIFIER (base =y).
CONFIG_DYNAMIC_FSYNC=y
CONFIG_DEVFREQ_BOOST=y
