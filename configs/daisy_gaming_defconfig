#  interactive gov, CPU/GPU OC tables, DEBUG_RODATA off (arm64 def_bool y),
#  LTO/CFI (needs clang runtime this 4.9 lacks), KEXEC/LKDTM (reboot risk).
# --- kernel-level mod apps (mem/debug that CAN work) ---
CONFIG_DEVMEM=y
# CONFIG_DEVKMEM is not set
# --- memory mgmt: KSM + memcg + zram writeback + reclaim stats ---
CONFIG_KSM=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_VM_EVENT_COUNTERS=y
CONFIG_COMPACT_UNEVICTABLE_DEFAULT=1
# --- crypto/fs: F2FS encryption + compression + check ---
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_CHECK_FS=y
# --- net/filter extras modern apps expect ---
CONFIG_BPF_JIT_ALWAYS_ON=y
# --- debuggability: sysrq + lockup + hung-task ---
CONFIG_MAGIC_SYSRQ=y
CONFIG_DETECT_HUNG_TASK=y
# NOTE: DEBUG_KERNEL stays OFF: this 4.9 tree's include/net/netfilter/nf_log.h
# gates real declarations on "#ifdef CONFIG_DEBUG_KERNEL", but Kconfig bool
# symbols are NOT passed as -D flags, so the stub branch stays active while
# net/netfilter/nf_log.c still defines the real functions -> redefinition
# build break (verified 2026-09-14, 561 errors). Debug needs are covered by
