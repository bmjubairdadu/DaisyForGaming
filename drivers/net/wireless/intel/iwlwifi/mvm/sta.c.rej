 		ret = iwl_mvm_drain_sta(mvm, mvm_sta, true);
@@ -3022,7 +3032,7 @@ void iwl_mvm_sta_modify_sleep_tx_count(struct iwl_mvm *mvm,
 				       struct ieee80211_sta *sta,
