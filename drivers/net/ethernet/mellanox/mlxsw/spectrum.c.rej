 	}
 
 	/* Map all priorities to traffic class 0. */
@@ -4171,6 +4183,8 @@ static int mlxsw_sp_netdevice_port_upper_event(struct net_device *dev,
 			return -EINVAL;
 		if (!info->linking)
 			break;
