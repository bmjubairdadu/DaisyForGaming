+	 */
+	if (__test_and_set_bit(type_idx, found))
+		return -EEXIST;
+
 	part->nvram_type = type;
 
 	MCDI_SET_DWORD(inbuf, NVRAM_METADATA_IN_TYPE, type);
@@ -5147,6 +5159,7 @@ static int efx_ef10_mtd_probe_partition(struct efx_nic *efx,
