--- drivers/net/ethernet/freescale/fman/fman_mac.h
+++ drivers/net/ethernet/freescale/fman/fman_mac.h
@@ -252,7 +252,7 @@ static inline struct eth_hash_t *alloc_hash_table(u16 size)
