 	}
 
 	for (i = 0; i < 500; i++) {
@@ -3429,7 +3451,10 @@ static void r8153_init(struct r8152 *tp)
 		ocp_data = ocp_reg_read(tp, OCP_PHY_STATUS) & PHY_STAT_MASK;
