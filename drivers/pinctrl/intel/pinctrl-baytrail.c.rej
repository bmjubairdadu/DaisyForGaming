 	case PIN_CONFIG_BIAS_DISABLE:
@@ -1127,9 +1153,9 @@ static int byt_pin_config_get(struct pinctrl_dev *pctl_dev, unsigned int offset,
 		if (!(conf & BYT_DEBOUNCE_EN))
 			return -EINVAL;
 
