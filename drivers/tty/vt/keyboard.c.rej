--- drivers/tty/vt/keyboard.c
+++ drivers/tty/vt/keyboard.c
@@ -121,10 +121,15 @@ static const int NR_TYPES = ARRAY_SIZE(max_vals);
 static struct input_handler kbd_handler;
 static DEFINE_SPINLOCK(kbd_event_lock);
