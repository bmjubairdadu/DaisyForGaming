 		if (retval)
 			dev_err(&dev->udev->dev,
@@ -808,7 +802,7 @@ static int tower_probe (struct usb_interface *interface, const struct usb_device
 	struct lego_usb_tower *dev = NULL;
 	struct usb_host_interface *iface_desc;
