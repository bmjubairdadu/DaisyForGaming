+
 	switch (need) {
 	case ZFCP_ERP_ACTION_REOPEN_LUN:
 		zfcp_sdev = sdev_to_zfcp(sdev);
@@ -193,9 +257,8 @@ static struct zfcp_erp_action *zfcp_erp_setup_act(int need, u32 act_status,
