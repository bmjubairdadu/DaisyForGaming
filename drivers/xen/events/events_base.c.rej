 		vcpu_info->evtchn_upcall_pending = 0;
@@ -1237,7 +1620,7 @@ static void __xen_evtchn_do_upcall(void)
 		if (__this_cpu_inc_return(xed_nesting_count) - 1)
 			goto out;
 
