 			pr_warn_ratelimited("bad qp type\n");
 			goto err1;
 		}
@@ -225,9 +230,14 @@ static int hdr_check(struct rxe_pkt_info *pkt)
 		goto err1;
 	}
 
+	if (unlikely(qpn == 0)) {
+		pr_warn_once("QP 0 not supported");
