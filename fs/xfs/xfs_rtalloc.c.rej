 		xfs_trans_log_inode(tp, mp->m_rsumip, XFS_ILOG_CORE);
 		/*
 		 * Copy summary data from old to new sizes.
@@ -1222,13 +1239,11 @@ xfs_rtmount_inodes(
 	xfs_sb_t	*sbp;
 
