-		blk_register_tracepoints();
+	get_probe_ref();
 
 	return 0;
 err:
@@ -531,9 +571,8 @@ err:
 	return ret;
 }
 
-int blk_trace_setup(struct request_queue *q, char *name, dev_t dev,
