--- tools/perf/util/dwarf-aux.c
+++ tools/perf/util/dwarf-aux.c
@@ -317,21 +317,59 @@ bool die_is_func_def(Dwarf_Die *dw_die)
 		dwarf_attr(dw_die, DW_AT_declaration, &attr) == NULL);
